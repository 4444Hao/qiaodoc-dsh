{
  "name": "qiaomu-reader-dsh",
  "version": "1.2.0-dev.2",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  },
  "description": "DSH 对话内文档阅读与选段交互，按格式查看文档历史并返回原对话。",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "docs/qa/adaptation-*.png",
    "docs/READER-ADAPTATION.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "books": "node scripts/make-starter-books.mjs",
    "resources": "node scripts/generate-pdf-resources.mjs",
    "prepack": "npm run build && node scripts/verify-package.mjs",
    "check": "npm run build && npm test && node scripts/verify-package.mjs",
    "dev:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-test.ps1 -Action Check",
    "dev:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-test.ps1 -Action Prepare",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-test.ps1 -Action Serve",
    "dev:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-test.ps1 -Action Browser",
    "test:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-test.ps1 -Action Smoke",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop.ps1",
    "dev:desktop:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop.ps1 -Rollback"
  },
  "meta": {
    "title": "文档历史",
    "description": "DSH 对话内文档阅读与选段交互，按格式查看文档历史并返回原对话。"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "meta": {
      "title": "文档历史",
      "description": "DSH 对话内文档阅读与选段交互，按格式查看文档历史并返回原对话。"
    }
  },
  "dependencies": {
    "marked": "18.1.2",
    "parse5": "8.0.1",
    "pdfjs-dist": "^6.2.108"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/4444Hao/qiaodoc-dsh.git"
  },
  "homepage": "https://github.com/4444Hao/qiaodoc-dsh#readme",
  "bugs": {
    "url": "https://github.com/4444Hao/qiaodoc-dsh/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qiaomu",
    "epub",
    "reading"
  ]
}
